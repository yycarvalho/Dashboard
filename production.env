# Configurações de Produção - Sistema de Pedidos API
# Copie este arquivo para .env e ajuste os valores conforme necessário

# Ambiente
ENVIRONMENT=production

# Configurações do Servidor
HOST=0.0.0.0
PORT=8080

# Configurações de Segurança
JWT_SECRET=sua_chave_jwt_super_secreta_aqui_2024_producao
JWT_EXPIRATION=86400000

# Configurações de Banco de Dados (para futuras implementações)
DB_URL=jdbc:postgresql://localhost:5432/pedidos_db
DB_USER=pedidos_user
DB_PASSWORD=senha_super_secreta_2024

# Configurações de Log
LOG_LEVEL=INFO
LOG_FILE=logs/sistema_pedidos.log

# Configurações de CORS
ALLOWED_ORIGINS=https://seudominio.com,https://www.seudominio.com

# Configurações de Rate Limiting
MAX_REQUESTS_PER_MINUTE=100

# Configurações de Performance
MAX_CONNECTIONS=100
REQUEST_TIMEOUT=30

# Configurações de Monitoramento
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true